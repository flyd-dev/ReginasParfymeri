# Hvor katalogen hentes fra:
#   utdrag – lagret utdrag av Reginas offentlige Store API (data/katalog, standard)
#   live   – leser Store API direkte (kun GET), mellomlagret på serveren
KATALOG_KILDE=utdrag

# Reginas WooCommerce. Store API-et er offentlig og krever ingen nøkkel for lesing.
WOO_URL=https://nettbutikk.reginaparfymeri.no

# Hvor lenge live-katalogen mellomlagres (sekunder).
KATALOG_LEVETID=300

# Kassen:
#   konsept     – ingen videresending, ingen bestilling (standard)
#   woocommerce – sender handlekurven til WooCommerce via delbar kasse-lenke
#                 (/checkout-link/?products=ID:ANTALL). IKKE verifisert mot Reginas butikk.
NEXT_PUBLIC_KASSE=konsept
