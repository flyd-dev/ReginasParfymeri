# Kopier til .env.local. Hemmeligheter (merket «hemmelig») skal bare ligge i .env.local og Vercel env –
# aldri i git og aldri med NEXT_PUBLIC_.

# --- Katalog ---
# json        – data/products.json m.fl. (standard; prototype uten staging)
# woocommerce – Store API på WOO_URL (staging etter import, eller produksjon bare for lesing)
DATA_SOURCE=json
WOO_URL=https://nettbutikk.reginaparfymeri.no
# Hvor lenge Store API-data mellomlagres (sekunder). Webhooks revaliderer før det.
KATALOG_LEVETID=300

# --- Handlekurv ---
# Standard: lokal kurv når DATA_SOURCE=json, WooCommerce-kurv (Store API + Cart-Token) når DATA_SOURCE=woocommerce.
# KURV=lokal | woocommerce overstyrer.
# KURV=
# Kurv mot produksjonsverten er stengt til lansering. Settes til «ja» først når nettbutikken lanseres.
# TILLAT_KURV_PRODUKSJON=

# --- Kasse og konto (WooCommerce) ---
# Der WooCommerce-kassen og «Min konto» ligger, f.eks. https://kasse.reginaparfymeri.no
NEXT_PUBLIC_KASSE_URL=https://nettbutikk.reginaparfymeri.no

# --- Nettstedet ---
NEXT_PUBLIC_SITE_URL=https://nettbutikk.reginaparfymeri.no
# «pa» åpner for søkemotorer (robots.txt, noindex). Leses ved bygg. Står av til lansering.
# INDEKSERING=pa

# --- Revalidering (hemmelig) ---
# WooCommerce → Innstillinger → Avansert → Webhooks (product.created/updated/deleted) → /api/revalidate/
# WOO_WEBHOOK_SECRET=
# Samme verdi som REGINA_REVALIDATE_SECRET i wp-config.php (mu-pluginen: kampanjer, butikkinfo)
# REGINA_REVALIDATE_SECRET=

# --- Valgfritt ---
# Google Analytics 4. Lastes bare etter samtykke; uten verdi vises ikke samtykkebanneret.
# NEXT_PUBLIC_GA4_ID=
# Innmeldingslenke til kundeklubben i Diller
# NEXT_PUBLIC_DILLER_INNMELDING_URL=

# --- Import til staging (hemmelig, bare for scripts/import_to_woocommerce.ts) ---
# WC_STAGING_URL=https://staging.nettbutikk.reginaparfymeri.no
# WC_STAGING_KEY=
# WC_STAGING_SECRET=
